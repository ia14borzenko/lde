# LDE toolchain environment (shell snippet, no secrets).
# Source from bash:  . toolchain/env.env
# All paths can be overridden from the environment before sourcing.
#
# Heavy tools live outside the repo, by default in $HOME/.local/share/lde-tools:
#   TinyTeX/    (TeX Live / TinyTeX, ~0.5-1 GB)
#   downloads/  (installer tarballs)
#   cache/      (Studio browser profile etc.)
# Another location for this machine: LDE_TOOLS_DIR=/path in toolchain/local.env (not in git).
# The repo itself keeps only code, templates and docs.

# Root of the LDE checkout (bin/lde sets this; fallback for manual sourcing).
: "${LDE_ROOT:=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)}"

# Machine-local settings (not in git), e.g. LDE_TOOLS_DIR=/data/lde-tools
if [ -z "${LDE_TOOLS_DIR:-}" ] && [ -f "$LDE_ROOT/toolchain/local.env" ]; then
  # shellcheck disable=SC1091
  . "$LDE_ROOT/toolchain/local.env"
fi
# Where heavy toolchain payloads are installed.
LDE_TOOLS_DIR="${LDE_TOOLS_DIR:-$HOME/.local/share/lde-tools}"

# TinyTeX / TeX Live distribution managed by toolchain/install.sh.
LDE_TINYTEX_DIR="${LDE_TINYTEX_DIR:-$LDE_TOOLS_DIR/TinyTeX}"
LDE_TEX_BIN="$LDE_TINYTEX_DIR/bin/x86_64-linux"

# Pinned static pandoc (installed by toolchain/install.sh).
LDE_PANDOC="${LDE_PANDOC:-$HOME/.local/bin/pandoc}"

# Python virtualenv with python-docx/lxml/PyMuPDF/Pillow/PyYAML.
LDE_VENV="${LDE_VENV:-$LDE_ROOT/toolchain/venv}"
LDE_PY="${LDE_PY:-$LDE_VENV/bin/python}"

# Rendering backend for DOCX -> PDF checks (LibreOffice headless).
LDE_SOFFICE="${LDE_SOFFICE:-soffice}"

# Default TeX engine used by `lde build`: xelatex (fontspec + Unicode Cyrillic).
LDE_ENGINE="${LDE_ENGINE:-xelatex}"

# Default math mode for `lde docx`: omml | svg | auto.
# Decided by experiments/formulas (see docs/formulas.md).
LDE_MATH_MODE="${LDE_MATH_MODE:-omml}"

# Where the project-level logs go (per-project <project>/logs, repo-level logs/).
LDE_LOG_DIR="${LDE_LOG_DIR:-$LDE_ROOT/logs}"

# Timeout (seconds) for network operations in install/doctor.
LDE_NET_TIMEOUT="${LDE_NET_TIMEOUT:-600}"
