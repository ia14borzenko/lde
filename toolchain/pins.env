# toolchain/pins.env — зафиксированные версии внешних компонентов (source, no secrets).
# Проверено и установлено 2026-10-31 на Ubuntu 26.04 (Linux 7.0.0-27, x86_64).
# Обновлять осознанно: после обновления пересобрать venv/TeX и обновить versions.lock.

TINYTEX_VERSION="v2026.10"                 # TeX Live 2026 (сборка TinyTeX)
TINYTEX_ASSET="TinyTeX-linux-x86_64-${TINYTEX_VERSION}.tar.xz"
TINYTEX_URL="https://github.com/rstudio/tinytex-releases/releases/download/${TINYTEX_VERSION}/${TINYTEX_ASSET}"
TINYTEX_SHA256="54fec1c79ab437d2d52e2f918bdb738c85779d654a93e62cc44f022e227692b5"

PANDOC_VERSION="3.13"
PANDOC_ASSET="pandoc-${PANDOC_VERSION}-linux-amd64.tar.gz"
PANDOC_URL="https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/${PANDOC_ASSET}"
PANDOC_SHA256="38aa33b325a2bc96a4c39409631212db55702f564250bcdbead180b3bf646389"

# Репозиторий TeX Live для tlmgr
TEXLIVE_REPOSITORY="https://mirror.ctan.org/systems/texlive/tlnet"
